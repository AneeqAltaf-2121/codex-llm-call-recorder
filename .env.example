# Copy this file to .env and fill in real values. Never commit .env.
#
# CodexProbe itself does not read .env automatically -- export these into
# your shell (or use a tool like `direnv`/`python-dotenv` in your own
# scripts) before running `codex-probe` or Codex CLI.

# Required for examples/openai_backend.json (backend.api_key_env).
OPENAI_API_KEY=

# Codex CLI itself also needs an API key for whichever provider it's
# pointed at -- when pointed at CodexProbe, Codex's own `env_key` should
# reference the same variable name configured in your Codex config's
# [model_providers.codex_probe] section. It does not need to hold a real
# value when the backend is a local, unauthenticated server (e.g. Ollama).
